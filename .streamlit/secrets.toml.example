# Streamlit Community Cloud 用の Secrets テンプレート
#
# 【クラウド】App settings → Secrets に、下記の中身（コメント以外）を貼り付ける
# 【ローカル】このファイルを secrets.toml にコピーして値を入れる（.env でも可）
#
# secrets.toml（実ファイル）は .gitignore 済み。コミットしないこと。

# どちらか一方を設定（キーの先頭で自動判別: AIza... → Gemini / sk-ant-... → Claude）
GEMINI_API_KEY = "AIza...ここに Google AI Studio のキー"
# ANTHROPIC_API_KEY = "sk-ant-...ここに Anthropic Console のキー"

# 任意: 設定するとアクセス時にパスワード入力を求める。
# 未設定なら誰でもアクセス可（API のクォータを他人に消費される点に注意）。
# APP_PASSWORD = "好きなパスワード"
